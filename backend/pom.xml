<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.icbc.aiops</groupId>
    <artifactId>langfuse-web-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>langfuse-web-service</name>
    <description>Decoupled Langfuse Web API and synchronous CRUD service</description>

    <properties>
        <java.version>1.8</java.version>
        <mybatis-spring-boot.version>2.3.2</mybatis-spring-boot.version>
        <clickhouse-jdbc.version>0.4.6</clickhouse-jdbc.version>
        <polardbx-connector.version>2.2.12</polardbx-connector.version>
        <lombok.version>1.18.36</lombok.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Managed by Spring Boot 2.7.18 (Spring Security 5.7.x); Java 8 compatible. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
            <version>${clickhouse-jdbc.version}</version>
        </dependency>
        <!--
          PolarDB-X Connector is a self-contained fork of Connector/J: the whole driver, including
          the MySQL wire protocol implementation, lives under com.alibaba.polardbx.core.cj.* and the
          artifact contains no reference to com.mysql. No separate MySQL driver is required, and the
          intranet Maven repository carries no com.mysql groupId. Keep POLARDBX_JDBC_URL on
          jdbc:polardbx:// - com.alibaba.polardbx.Driver owns that scheme and does not accept
          jdbc:mysql:// URLs.
        -->
        <dependency>
            <groupId>com.alibaba.polardbx</groupId>
            <artifactId>polardbx-connector-java</artifactId>
            <version>${polardbx-connector.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- On newer JDKs, the release flag prevents use of APIs absent from Java 8. -->
        <profile>
            <id>enforce-java8-api-on-newer-jdks</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
        </profile>

        <!--
          In-house AAM integration. Activate only where the intranet Maven repository is
          reachable:  mvn -Paam ...

          com.icbc.hermes / com.icbc.ssic / com.icbc.aam are internal artifacts that do
          not exist on Maven Central, so they are NOT declared in the default build. The
          Hermes adapter lives in src/main/aam/java and is added as a source root only by
          this profile, which keeps the default build (and every test running outside the
          intranet) green.
        -->
        <profile>
            <id>aam</id>
            <properties>
                <hermes.version>6.69.5500050.0</hermes.version>
                <encrypt-client.version>7.1.2</encrypt-client.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.icbc.hermes</groupId>
                    <artifactId>hermes-aam</artifactId>
                    <version>${hermes.version}</version>
                    <exclusions>
                        <!-- Not needed here and not available on every build host. -->
                        <exclusion>
                            <groupId>com.icbc.hsm</groupId>
                            <artifactId>hsm-hardware-encryption</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>com.icbc.aam</groupId>
                    <artifactId>encrypt-client</artifactId>
                    <version>${encrypt-client.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>add-aam-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/main/aam/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
